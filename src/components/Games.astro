---
import Gamepad2 from '@lucide/astro/icons/gamepad-2';
import Rocket from '@lucide/astro/icons/rocket';
import Quote from '@lucide/astro/icons/quote';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { quotes } from '@/data/quotes';
import { site } from '@/data/site';
---

<section id="jogos" class="section-pad relative" aria-labelledby="jogos-title">
  <div class="container-site">
    <!-- Destaque dos jogos -->
    <div class="reveal relative overflow-hidden rounded-[2rem] p-[3px]">
      <div aria-hidden="true" class="hazard absolute inset-0 opacity-90"></div>
      <div class="relative grid items-center gap-8 rounded-[calc(2rem-3px)] bg-asphalt-950 p-8 md:grid-cols-[1fr_auto] md:p-12">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-stop px-3 py-1 font-display text-sm font-bold uppercase tracking-widest text-white">Novo!</span>
          <h2 id="jogos-title" class="mt-5 text-[clamp(2.4rem,6vw,4.5rem)] font-extrabold uppercase leading-[0.95] text-ink">
            <Gamepad2 class="mr-2 inline-block size-[0.85em] align-[-0.08em] text-signal" aria-hidden="true" />
            Aprenda brincando: nossos jogos
          </h2>
          <p class="mt-4 max-w-2xl text-lg text-ink-muted">
            Desenvolvemos simuladores e jogos interativos para você praticar a direção defensiva e a cidadania de forma divertida e segura.
          </p>
        </div>
        <a href={site.gamesUrl} target="_blank" rel="noopener" class="btn btn-primary animate-pulse-ring !min-h-16 !px-8 !text-xl">
          Acessar jogos agora
          <Rocket size={22} aria-hidden="true" />
          <span class="sr-only">(abre em nova aba)</span>
        </a>
      </div>
    </div>

    <!-- Citações -->
    <div class="mt-24">
      <SectionHeading eyebrow="Educação para o trânsito" title="Por que educar para o trânsito?" align="center" />
      <ul class="grid gap-4 md:grid-cols-2">
        {
          quotes.map((q) => (
            <li class="reveal">
              <figure class="card flex h-full flex-col p-7 md:p-8">
                <Quote size={34} class="text-signal" aria-hidden="true" />
                <blockquote class="mt-4 flex-1 text-xl leading-relaxed text-ink">“{q.text}”</blockquote>
                <figcaption class="mt-6 border-t border-asphalt-700 pt-4">
                  <strong class="block font-display text-lg uppercase tracking-wide text-ink">{q.author}</strong>
                  <cite class="text-sm not-italic text-ink-muted">{q.work}</cite>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

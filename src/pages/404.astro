---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import Base from '@/layouts/Base.astro';
import Logo from '@/components/ui/Logo.astro';
import Sign from '@/components/ui/Sign.astro';
---

<Base title="Página não encontrada | Trânsito Seguro" noindex>
  <main id="conteudo" class="container-site flex min-h-dvh flex-col items-center justify-center py-16 text-center">
    <a href="/" class="mb-12 rounded-lg" aria-label="Trânsito Seguro — início"><Logo /></a>
    <Sign id="R-2" class="size-40 drop-shadow-[0_18px_30px_rgb(0_0_0/0.5)]" />
    <p class="eyebrow mt-10">Erro 404</p>
    <h1 class="mt-3 text-[clamp(2.8rem,9vw,5.5rem)] font-extrabold uppercase leading-[0.95]">Rota não encontrada</h1>
    <p class="mt-4 max-w-md text-lg text-ink-muted">Esta página não existe ou mudou de endereço. Dê a preferência e volte para a via principal.</p>
    <a href="/" class="btn btn-primary mt-8">
      <ArrowLeft size={20} aria-hidden="true" />
      Voltar ao início
    </a>
  </main>
</Base>

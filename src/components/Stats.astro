---
import Gauge from '@lucide/astro/icons/gauge';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import Motorbike from '@lucide/astro/icons/motorbike';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Counter from '@/components/ui/Counter.astro';
import { cause, commonTypes, headline, recent, statsSources, yearly } from '@/data/stats';

const max = Math.max(...yearly.map((y) => y.value));
---

<section id="numeros" class="section-pad relative" aria-labelledby="numeros-title">
  <div class="container-site">
    <SectionHeading
      id="numeros-title"
      eyebrow="Nova Friburgo em números"
      title="Estatísticas de Nova Friburgo"
      intro="Os números revelam a urgência de uma mudança de comportamento no trânsito da nossa cidade. Em 2025, Nova Friburgo já registrou um número alarmante de acidentes, evidenciando a necessidade de maior conscientização e responsabilidade de todos os usuários das vias."
    />

    <!-- Cards principais -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        headline.map((stat) => {
          const Icon = stat.icon;
          return (
            <article class="card reveal group relative overflow-hidden p-6 transition-colors hover:border-signal/60">
              <Icon size={28} class="text-signal" aria-hidden="true" />
              <p class="mt-6 font-display text-[clamp(3.5rem,7vw,5rem)] font-extrabold leading-none text-ink">
                <Counter value={stat.value} prefix={'prefix' in stat ? stat.prefix : ''} />
              </p>
              <h3 class="mt-3 font-display text-xl font-bold uppercase tracking-wide text-ink">{stat.label}</h3>
              <p class="mt-2 text-sm text-ink-muted">{stat.detail}</p>
              <span aria-hidden="true" class="lane absolute inset-x-0 bottom-0 origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100"></span>
            </article>
          );
        })
      }
      <article class="@container reveal relative overflow-hidden rounded-[1.25rem] bg-stop p-6 text-white">
        <Gauge size={28} aria-hidden="true" />
        <h3 class="mt-6 font-display text-xl font-bold uppercase tracking-wide text-white/85">{cause.label}</h3>
        <p class="mt-1 font-display text-[clamp(1.9rem,18cqi,3.6rem)] font-extrabold uppercase leading-none">{cause.value}</p>
        <p class="mt-3 text-sm text-white/85">{cause.detail}</p>
        <span aria-hidden="true" class="absolute -right-6 -top-6 size-28 rounded-full border-[10px] border-white/15"></span>
      </article>
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-5">
      <!-- Gráfico anual -->
      <figure class="card reveal p-6 lg:col-span-3 md:p-8">
        <figcaption>
          <h3 class="font-display text-2xl font-bold uppercase text-ink">Ocorrências por ano</h3>
          <p class="mt-1 text-sm text-ink-muted">Registradas pelo Corpo de Bombeiros em Nova Friburgo. 2025 conta só de janeiro a setembro.</p>
        </figcaption>

        <div class="mt-8 flex h-64 items-end gap-4 border-b border-asphalt-600 sm:gap-8" aria-hidden="true">
          {
            yearly.map((y) => {
              const partial = 'note' in y;
              return (
                <div class="bar-col group flex h-full flex-1 flex-col items-center justify-end">
                  <span class="mb-2 font-display text-2xl font-bold tabular-nums text-ink">
                    {y.value.toLocaleString('pt-BR')}
                  </span>
                  <div
                    class:list={[
                      'bar w-full max-w-28 rounded-t-[4px] transition-[filter] group-hover:brightness-125',
                      partial ? 'bar-partial' : 'bg-asphalt-600',
                    ]}
                    style={`--h: ${(y.value / max) * 100}%`}
                  />
                </div>
              );
            })
          }
        </div>
        <div class="mt-3 flex gap-4 sm:gap-8" aria-hidden="true">
          {
            yearly.map((y) => (
              <p class="flex-1 text-center font-display text-lg font-semibold text-ink-muted">
                {y.year}
                {'note' in y && <span class="block text-xs font-medium uppercase tracking-wider text-signal">{y.note}</span>}
              </p>
            ))
          }
        </div>

        <div class="sr-only">
        <table>
          <caption>Ocorrências de trânsito por ano em Nova Friburgo</caption>
          <thead><tr><th scope="col">Ano</th><th scope="col">Ocorrências</th></tr></thead>
          <tbody>
            {
              yearly.map((y) => (
                <tr>
                  <th scope="row">{y.year}{'note' in y ? ` (${y.note})` : ''}</th>
                  <td>{y.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        </div>
      </figure>

      <!-- Dados mais recentes -->
      <article class="card reveal relative overflow-hidden p-6 lg:col-span-2 md:p-8">
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-full bg-route/15 text-route-light">
            <Motorbike size={24} aria-hidden="true" />
          </span>
          <div>
            <h3 class="font-display text-2xl font-bold uppercase leading-tight text-ink">Dados mais recentes</h3>
            <p class="text-sm text-ink-muted">{recent.period}</p>
          </div>
        </div>
        <dl class="mt-6 grid gap-5">
          {
            recent.items.map((item) => (
              <div class="flex items-baseline gap-4 border-b border-asphalt-700 pb-4 last:border-none last:pb-0">
                <dt class="sr-only">{item.label}</dt>
                <dd class="min-w-[5.5rem] font-display text-5xl font-extrabold leading-none text-signal">
                  <Counter value={item.value} suffix={item.suffix} />
                </dd>
                <dd class="text-ink" aria-hidden="true">{item.label}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 text-sm text-ink-muted">{recent.fleet}</p>
        <p class="mt-3 text-xs text-ink-muted/80">Fonte: {recent.source}</p>
      </article>
    </div>

    <!-- Alerta -->
    <div class="reveal mt-4 flex overflow-hidden rounded-[1.25rem] border border-signal/30 bg-signal/[0.06]">
      <div class="hazard w-3 shrink-0 sm:w-5" aria-hidden="true"></div>
      <div class="flex gap-4 p-6 md:p-8">
        <TriangleAlert size={32} class="mt-1 shrink-0 text-signal" aria-hidden="true" />
        <div>
          <h3 class="font-display text-2xl font-bold uppercase text-ink">{commonTypes.title}</h3>
          <p class="mt-2 text-ink-muted">{commonTypes.text}</p>
        </div>
      </div>
    </div>

    <p class="mt-8 text-sm text-ink-muted">
      <span class="font-semibold text-ink">Fontes:</span>
      {
        statsSources.map((source, i) => (
          <>
            <a href={source.url} target="_blank" rel="noopener" class="underline decoration-asphalt-600 underline-offset-4 hover:text-signal hover:decoration-signal">
              {source.label}
            </a>
            {i < statsSources.length - 1 && <span aria-hidden="true"> · </span>}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .bar {
    height: var(--h);
    transform-origin: bottom;
  }

  .bar-partial {
    background:
      repeating-linear-gradient(135deg, rgb(10 12 15 / 0.28) 0 6px, transparent 6px 12px),
      var(--color-signal);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bar {
        animation: bar-grow linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }

  @keyframes bar-grow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
</style>

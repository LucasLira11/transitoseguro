---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import Gamepad2 from '@lucide/astro/icons/gamepad-2';
import Logo from '@/components/ui/Logo.astro';
import { nav, site } from '@/data/site';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50" data-scrolled="false">
  <div class="header-bar border-b border-transparent transition-colors duration-300">
    <div class="container-site flex h-[4.5rem] items-center justify-between gap-4">
      <a href="#inicio" class="shrink-0 rounded-lg" aria-label="Trânsito Seguro — início">
        <Logo compact />
      </a>

      <nav aria-label="Principal" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  class="rounded-full px-3.5 py-2 font-display text-[1.05rem] font-semibold uppercase tracking-wider text-ink-muted transition-colors hover:text-ink aria-[current=true]:text-signal"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={site.gamesUrl} target="_blank" rel="noopener" class="btn btn-primary !min-h-11 !px-4 !text-base">
          <Gamepad2 size={20} aria-hidden="true" />
          <span>Jogos</span>
          <span class="sr-only">(abre em nova aba)</span>
        </a>
        <button
          type="button"
          id="menu-toggle"
          class="grid size-11 place-items-center rounded-full border border-asphalt-600 text-ink transition-colors hover:border-signal hover:text-signal lg:hidden"
          aria-expanded="false"
          aria-controls="menu-mobile"
          aria-label="Abrir menu"
        >
          <Menu size={22} class="icon-open" aria-hidden="true" />
          <X size={22} class="icon-close hidden" aria-hidden="true" />
        </button>
      </div>
    </div>

    <nav id="menu-mobile" aria-label="Principal (celular)" class="border-t border-asphalt-800 bg-asphalt-950/95 backdrop-blur-xl lg:hidden" hidden>
      <ul class="container-site grid gap-1 py-4">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between rounded-xl px-3 py-3 font-display text-2xl font-bold uppercase tracking-wide text-ink hover:bg-asphalt-900 hover:text-signal"
              >
                {item.label}
                <span aria-hidden="true" class="lane w-8 opacity-60"></span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="scroll-progress lane" aria-hidden="true"></div>
</header>

<style>
  [data-scrolled='true'] .header-bar {
    background-color: rgb(10 12 15 / 0.78);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-color: var(--color-asphalt-800);
  }

  .scroll-progress {
    display: none;
    transform-origin: 0 50%;
    height: 3px;
  }

  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      display: block;
      animation: grow-x linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes grow-x {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const panel = document.getElementById('menu-mobile')!;

  const onScroll = () => {
    header.dataset.scrolled = String(window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    panel.hidden = !open;
    header.dataset.scrolled = open ? 'true' : String(window.scrollY > 24);
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !panel.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (mq) => {
    if (mq.matches) setOpen(false);
  });

  // Destaca no menu a seção visível
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((el): el is HTMLElement => el !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) {
          link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`));
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => observer.observe(section));
</script>

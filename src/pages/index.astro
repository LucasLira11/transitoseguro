---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Stats from '@/components/Stats.astro';
import Tips from '@/components/Tips.astro';
import Signs from '@/components/Signs.astro';
import Laws from '@/components/Laws.astro';
import Emergency from '@/components/Emergency.astro';
import MaioAmarelo from '@/components/MaioAmarelo.astro';
import Games from '@/components/Games.astro';
import Quiz from '@/components/Quiz.astro';
import About from '@/components/About.astro';
import Footer from '@/components/Footer.astro';
import EmergencyFab from '@/components/EmergencyFab.astro';
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Stats />
    <Tips />
    <Signs />
    <Laws />
    <Emergency />
    <MaioAmarelo />
    <Games />
    <Quiz />
    <About />
  </main>
  <Footer />
  <EmergencyFab />
</Base>

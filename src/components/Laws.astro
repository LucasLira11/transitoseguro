---
import Scale from '@lucide/astro/icons/scale';
import ExternalLink from '@lucide/astro/icons/external-link';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ctbUrl, infractions, lawsDisclaimer, lawsIntro, natures, naturesNote, suspension, type Severity } from '@/data/laws';

const natureColor = ['bg-route', 'bg-signal', 'bg-caution', 'bg-stop'];
const severityStyle: Record<Severity, { chip: string; label: string }> = {
  leve: { chip: 'bg-route text-white', label: 'Leve' },
  media: { chip: 'bg-signal text-asphalt-950', label: 'Média' },
  grave: { chip: 'bg-caution text-asphalt-950', label: 'Grave' },
  gravissima: { chip: 'bg-stop text-white', label: 'Gravíssima' },
};
---

<section id="leis" class="section-pad relative border-t border-asphalt-800 bg-asphalt-900/40" aria-labelledby="leis-title">
  <div class="container-site">
    <SectionHeading id="leis-title" eyebrow="Código de Trânsito Brasileiro" title="Leis e multas" intro={lawsIntro} />

    <div class="grid gap-4 lg:grid-cols-5">
      <!-- Naturezas -->
      <div class="card reveal min-w-0 p-6 lg:col-span-3 md:p-8">
        <h3 class="font-display text-2xl font-bold uppercase text-ink">Natureza da infração</h3>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[26rem] border-separate border-spacing-y-2 text-left">
            <thead>
              <tr class="font-display text-sm uppercase tracking-[0.15em] text-ink-muted">
                <th scope="col" class="px-4 pb-1 font-semibold">Natureza</th>
                <th scope="col" class="px-4 pb-1 font-semibold">Pontos na CNH</th>
                <th scope="col" class="px-4 pb-1 text-right font-semibold">Multa</th>
              </tr>
            </thead>
            <tbody>
              {
                natures.map((n, i) => (
                  <tr class="bg-asphalt-800/70">
                    <th scope="row" class="rounded-l-xl px-4 py-3.5">
                      <span class="flex items-center gap-3 font-display text-xl font-bold uppercase text-ink">
                        <span aria-hidden="true" class:list={['h-7 w-1.5 rounded-full', natureColor[i]]} />
                        {n.name}
                      </span>
                    </th>
                    <td class="px-4 py-3.5">
                      <span class="font-display text-2xl font-extrabold text-ink">{n.points}</span>
                      <span class="text-sm text-ink-muted"> pontos</span>
                    </td>
                    <td class="rounded-r-xl px-4 py-3.5 text-right font-display text-2xl font-bold tabular-nums text-ink">{n.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm text-ink-muted">{naturesNote}</p>
      </div>

      <!-- Suspensão -->
      <div class="card reveal flex flex-col p-6 lg:col-span-2 md:p-8">
        <h3 class="font-display text-2xl font-bold uppercase text-ink">{suspension.title}</h3>
        <p class="mt-2 text-ink-muted">{suspension.text}</p>
        <ol class="mt-6 grid flex-1 content-start gap-3">
          {
            suspension.steps.map((step, i) => (
              <li class="flex items-center gap-4 rounded-xl bg-asphalt-800/70 p-4">
                <span
                  class:list={[
                    'grid size-16 shrink-0 place-items-center rounded-full border-4 font-display text-2xl font-extrabold',
                    i === 0 ? 'border-stop text-stop-light' : i === 1 ? 'border-caution text-caution' : 'border-signal text-signal',
                  ]}
                >
                  {step.points}
                </span>
                <span>
                  <span class="block font-display text-lg font-bold uppercase text-ink">{step.points} pontos</span>
                  <span class="text-sm text-ink-muted">{step.condition}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <!-- Infrações comuns -->
    <h3 class="reveal mt-20 font-display text-4xl font-extrabold uppercase text-ink">Infrações que mais colocam vidas em risco</h3>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        infractions.map((item) => (
          <li class="card reveal flex flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <span class:list={['rounded-full px-3 py-1 font-display text-sm font-bold uppercase tracking-wider', severityStyle[item.severity].chip]}>
                {item.nature}
              </span>
              <span class="pt-1 text-right text-xs font-medium text-ink-muted">{item.article}</span>
            </div>
            <h4 class="mt-5 font-display text-2xl font-bold uppercase leading-tight text-ink">{item.title}</h4>
            <p class="mt-1 font-display text-3xl font-extrabold tabular-nums text-signal">{item.fine}</p>
            <p class="mt-3 text-sm text-ink-muted">{item.detail}</p>
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-8 flex flex-col gap-4 rounded-2xl border border-asphalt-700 p-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-start gap-3 text-sm text-ink-muted">
        <Scale size={20} class="mt-0.5 shrink-0 text-route-light" aria-hidden="true" />
        {lawsDisclaimer}
      </p>
      <a href={ctbUrl} target="_blank" rel="noopener" class="btn btn-ghost shrink-0 !text-base">
        Ler o CTB completo
        <ExternalLink size={18} aria-hidden="true" />
        <span class="sr-only">(abre em nova aba)</span>
      </a>
    </div>
  </div>
</section>

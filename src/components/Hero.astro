---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import CircleHelp from '@lucide/astro/icons/circle-question-mark';
import { site } from '@/data/site';

const tape = ['Maio Amarelo', 'Enxergar o outro é salvar vidas', 'Reduza a velocidade', 'Celular no bolso', 'Pedestre tem preferência', 'Use o cinto', 'Capacete sempre'];
---

<section id="inicio" class="hero relative isolate flex min-h-[100svh] flex-col overflow-hidden" aria-labelledby="hero-title">
  <!-- Céu noturno e brilho do horizonte -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_55%_at_50%_42%,rgb(255_199_44/0.16),transparent_70%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_100%,rgb(47_111_214/0.18),transparent_70%)]"></div>
  </div>

  <!-- Estrada em perspectiva -->
  <div class="road" aria-hidden="true">
    <div class="road-plane">
      <div class="road-edge road-edge-l"></div>
      <div class="road-center"></div>
      <div class="road-edge road-edge-r"></div>
    </div>
  </div>

  <div class="container-site relative flex flex-1 flex-col items-center pt-32 text-center sm:pt-36">
    <p class="hero-in mb-7 inline-flex items-center gap-2.5 rounded-full border border-asphalt-700 bg-asphalt-900/70 px-4 py-2 text-sm font-medium text-ink-muted backdrop-blur">
      <span class="relative flex size-2.5">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-signal opacity-60 motion-reduce:hidden"></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-signal"></span>
      </span>
      Turma de Jogos Cooperativos · CEFET/RJ Nova Friburgo
    </p>

    <h1 id="hero-title" class="hero-in text-[clamp(3.4rem,12vw,9.5rem)] font-extrabold uppercase leading-[0.86] tracking-tight" style="--d: 80ms">
      <span class="block text-ink">Trânsito seguro</span>
      <span class="block text-signal">salva vidas</span>
    </h1>

    <p class="hero-in mt-7 max-w-xl text-lg text-ink-muted sm:text-xl" style="--d: 160ms">
      {site.tagline}.
    </p>

    <div class="hero-in mt-9 flex flex-wrap items-center justify-center gap-3" style="--d: 240ms">
      <a href="#numeros" class="btn btn-primary">
        Conheça os dados
        <ArrowDown size={20} aria-hidden="true" />
      </a>
      <a href="#quiz" class="btn btn-ghost bg-asphalt-950/40 backdrop-blur">
        <CircleHelp size={20} aria-hidden="true" />
        Faça o quiz
      </a>
    </div>
  </div>

  <!-- Fita de advertência -->
  <div class="relative z-10 mt-auto -rotate-1 border-y-2 border-asphalt-950 bg-signal py-2.5 text-asphalt-950 shadow-[0_-20px_60px_rgb(0_0_0/0.5)]" aria-hidden="true">
    <div class="tape flex w-max gap-8 whitespace-nowrap font-display text-xl font-extrabold uppercase tracking-wider">
      {
        [...tape, ...tape].map((item) => (
          <span class="flex items-center gap-8">
            {item}
            <span class="inline-block h-3 w-8 bg-asphalt-950 [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]"></span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .road {
    position: absolute;
    inset: auto 0 0 0;
    height: 58%;
    perspective: 420px;
    perspective-origin: 50% 0%;
    overflow: hidden;
    z-index: -1;
    -webkit-mask-image: linear-gradient(to top, #000 45%, transparent 100%);
    mask-image: linear-gradient(to top, #000 45%, transparent 100%);
  }

  .road-plane {
    position: absolute;
    left: 50%;
    bottom: -4%;
    width: min(780px, 150vw);
    height: 260%;
    transform: translateX(-50%) rotateX(72deg);
    transform-origin: 50% 100%;
    background:
      linear-gradient(90deg, transparent 0 1%, #1a1e25 1% 99%, transparent 99%),
      var(--color-asphalt-900);
    box-shadow: 0 0 120px 40px rgb(0 0 0 / 0.6);
  }

  .road-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 10px;
    background: #e9e9e4;
    opacity: 0.75;
  }
  .road-edge-l { left: 3%; }
  .road-edge-r { right: 3%; }

  .road-center {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 14px;
    translate: -50% 0;
    background: repeating-linear-gradient(to bottom, var(--color-signal) 0 70px, transparent 70px 150px);
    box-shadow: 0 0 18px rgb(255 199 44 / 0.35);
    animation: road-move 0.55s linear infinite;
  }

  @keyframes road-move {
    to { background-position: 0 150px; }
  }

  .tape {
    animation: tape 38s linear infinite;
  }

  @keyframes tape {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: var(--d, 0ms);
    }
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .road-center, .tape { animation: none; }
  }
</style>
